<!DOCTYPE html> <html lang="en"> <head> <meta charset="utf-8"> <meta name="viewport" content="width=device-width, initial-scale=1"> <title>Parmly Store — Software built for one industry at a time</title> <meta name="description" content="Parmly Store makes booking, client and finance tools for service businesses — one focused app per industry, nothing you don't need."> <link rel="stylesheet" href="styles.css"> </head> <body> <header class="nav"> <div class="container nav-inner"> <span class="logo">Parmly<span class="dot">.</span></span> <nav class="nav-links"> <a href="#products" data-i18n="nav_products">Products</a> <a href="https://naildesk.shop/#pricing" data-i18n="nav_pricing">Pricing</a> <a href="mailto:account@ollieconsult.com" data-i18n="nav_support">Support</a> </nav> <div class="nav-right"> <div class="locale-switch" id="localeSwitch"> <button class="locale-btn" id="localeBtn" aria-haspopup="true" aria-expanded="false">EN</button> <div class="locale-menu"> <button data-locale="en">EN</button> <button data-locale="zh-hant">繁</button> <button data-locale="zh-hans">简</button> </div> </div> <a class="btn btn-primary btn-sm" href="https://app.naildesk.shop" data-i18n="nav_get_started">Get started</a> </div> </div> </header> <section class="hero container"> <span class="badge" data-i18n="badge">You do operation, we do management</span> <h1 data-i18n="h1">Software built for one industry at a time</h1> <p data-i18n="subtext">Parmly Store makes booking, client and finance tools for service businesses — one focused app per industry, nothing you don't need.</p> <div class="hero-actions"> <a class="btn btn-primary btn-lg" href="https://app.naildesk.shop" data-i18n="hero_get_started">Get started</a> <a class="btn btn-secondary btn-lg" href="#products" data-i18n="hero_see_products">See all products</a> </div> </section> <section id="products" class="container" style="padding-bottom: var(--space-9);"> <div class="section-head"> <h2 data-i18n="products_header">Our products</h2> <p class="note" data-i18n="products_note">NailDesk and StudioDesk are live. Three more are on the way.</p> </div> <div class="product-grid"> <div class="product-card product-naildesk"> <div class="product-card-top"> <div class="product-icon"><span class="dot"></span></div> <span class="status-badge status-live"><span class="dot"></span><span data-i18n="nail_status">Live - Most Popular</span></span> </div> <div> <h3>NailDesk</h3> <p class="product-tagline" data-i18n="nail_tagline">For nail salons</p> </div> <p class="product-desc" data-i18n="nail_desc">Bookings, clients and finances built for one chair or ten.</p> <a class="btn btn-secondary btn-sm" href="https://naildesk.shop" data-i18n="nail_cta">Explore NailDesk</a> </div> <div class="product-card product-traindesk"> <div class="product-card-top"> <div class="product-icon"><span class="dot"></span></div> <span class="status-badge status-soon"><span class="dot"></span><span data-i18n="train_status">Coming Soon</span></span> </div> <div> <h3>TrainDesk</h3> <p class="product-tagline" data-i18n="train_tagline">For personal trainers</p> </div> <p class="product-desc" data-i18n="train_desc">Sessions, packages and payments, all in one calendar.</p> <span class="btn btn-ghost btn-sm btn-disabled" data-i18n="train_cta">Notify me</span> </div> <div class="product-card product-pilatesdesk"> <div class="product-card-top"> <div class="product-icon"><span class="dot"></span></div> <span class="status-badge status-live"><span class="dot"></span><span data-i18n="studio_status">Live</span></span> </div> <div> <h3>StudioDesk</h3> <p class="product-tagline" data-i18n="studio_tagline">For yoga, Pilates &amp; Lagree studios</p> </div> <p class="product-desc" data-i18n="studio_desc">Class scheduling, memberships and studio finances together.</p> <a class="btn btn-secondary btn-sm" href="https://studiodesk.store" data-i18n="studio_cta">Explore StudioDesk</a> </div> <div class="product-card product-tutordesk"> <div class="product-card-top"> <div class="product-icon"><span class="dot"></span></div> <span class="status-badge status-soon"><span class="dot"></span><span data-i18n="tutor_status">Coming Soon</span></span> </div> <div> <h3>TutorDesk</h3> <p class="product-tagline" data-i18n="tutor_tagline">For tutors</p> </div> <p class="product-desc" data-i18n="tutor_desc">Lesson bookings, student records and invoicing, simplified.</p> <span class="btn btn-ghost btn-sm btn-disabled" data-i18n="tutor_cta">Notify me</span> </div> <div class="product-card product-salondesk"> <div class="product-card-top"> <div class="product-icon"><span class="dot"></span></div> <span class="status-badge status-soon"><span class="dot"></span><span data-i18n="salon_status">Coming Soon</span></span> </div> <div> <h3>SalonDesk</h3> <p class="product-tagline" data-i18n="salon_tagline">For hair &amp; beauty salons</p> </div> <p class="product-desc" data-i18n="salon_desc">Chair bookings, client history and payroll, unified.</p> <span class="btn btn-ghost btn-sm btn-disabled" data-i18n="salon_cta">Notify me</span> </div> </div> </section> <section class="features"> <div class="container features-grid"> <div class="feature"> <h3 data-i18n="feat1_h">Built for small teams</h3> <p data-i18n="feat1_p">Every product is scoped to run a single-location service business end to end — no bloated enterprise settings.</p> </div> <div class="feature"> <h3 data-i18n="feat2_h">Australia &amp; Hong Kong ready</h3> <p data-i18n="feat2_p">Full support for English, Traditional Chinese and Simplified Chinese, with local payment and tax norms.</p> </div> <div class="feature"> <h3 data-i18n="feat3_h">One account, every app</h3> <p data-i18n="feat3_p">Your Parmly Store login carries across every desk product as you add them.</p> </div> </div> </section> <section class="cta container"> <h2 data-i18n="cta_h">Running a service business? There's a Desk for that.</h2> <a class="btn btn-primary btn-lg" href="https://naildesk.shop" data-i18n="cta_button">Explore NailDesk</a> </section> <footer class="footer"> <div class="container footer-inner"> <span class="footer-logo">Parmly<span class="dot">.</span></span> <span class="footer-copy" data-i18n="footer_copy">© 2026 Parmly Store. Sydney &amp; Hong Kong.</span> </div> </footer> <script> var translations = { en: { nav_products: "Products", nav_pricing: "Pricing", nav_support: "Support", nav_get_started: "Get started", badge: "You do operation, we do management", h1: "Software built for one industry at a time", subtext: "Parmly Store makes booking, client and finance tools for service businesses — one focused app per industry, nothing you don't need.", hero_get_started: "Get started", hero_see_products: "See all products", products_header: "Our products", products_note: "NailDesk and StudioDesk are live. Three more are on the way.", nail_status: "Live - Most Popular", nail_tagline: "For nail salons", nail_desc: "Bookings, clients and finances built for one chair or ten.", nail_cta: "Explore NailDesk", train_status: "Coming Soon", train_tagline: "For personal trainers", train_desc: "Sessions, packages and payments, all in one calendar.", train_cta: "Notify me", studio_status: "Live", studio_tagline: "For yoga, Pilates & Lagree studios", studio_desc: "Class scheduling, memberships and studio finances together.", studio_cta: "Explore StudioDesk", tutor_status: "Coming Soon", tutor_tagline: "For tutors", tutor_desc: "Lesson bookings, student records and invoicing, simplified.", tutor_cta: "Notify me", salon_status: "Coming Soon", salon_tagline: "For hair & beauty salons", salon_desc: "Chair bookings, client history and payroll, unified.", salon_cta: "Notify me", feat1_h: "Built for small teams", feat1_p: "Every product is scoped to run a single-location service business end to end — no bloated enterprise settings.", feat2_h: "Australia & Hong Kong ready", feat2_p: "Full support for English, Traditional Chinese and Simplified Chinese, with local payment and tax norms.", feat3_h: "One account, every app", feat3_p: "Your Parmly Store login carries across every desk product as you add them.", cta_h: "Running a service business? There's a Desk for that.", cta_button: "Explore NailDesk", footer_copy: "© 2026 Parmly Store. Sydney & Hong Kong." }, "zh-hant": { nav_products: "產品", nav_pricing: "價格", nav_support: "支援", nav_get_started: "開始使用", badge: "你負責營運，我們負責管理", h1: "為單一行業打造的軟件", subtext: "Parmly Store 為服務業提供預約、客戶和財務管理工具——每個行業一個專屬應用，沒有多餘功能。", hero_get_started: "開始使用", hero_see_products: "查看所有產品", products_header: "我們的產品", products_note: "NailDesk 和 StudioDesk 已上線，還有三個即將推出。", nail_status: "已上線・最受歡迎", nail_tagline: "美甲店專用", nail_desc: "為一張或十張美甲椅打造的預約、客戶和財務管理。", nail_cta: "了解 NailDesk", train_status: "即將推出", train_tagline: "私人教練專用", train_desc: "課程、套票和付款，全部在一個日曆內完成。", train_cta: "通知我", studio_status: "已上線", studio_tagline: "瑜伽、皮拉提斯與Lagree專用", studio_desc: "課程安排、會籍和工作室財務管理。", studio_cta: "了解 StudioDesk", tutor_status: "即將推出", tutor_tagline: "補習老師專用", tutor_desc: "簡化課程預約、學生記錄和發票。", tutor_cta: "通知我", salon_status: "即將推出", salon_tagline: "美髮美容院專用", salon_desc: "統一椅位預約、客戶記錄和薪資。", salon_cta: "通知我", feat1_h: "為小型團隊打造", feat1_p: "每個產品都專為單一地點的服務業設計，沒有繁琴的企業設定。", feat2_h: "澳洲和香港皮適用", feat2_p: "全面支援英文、繁體中文和簡體中文，符合當地付款和稅務規範。", feat3_h: "一個帳戶，通用所有應用", feat3_p: "你的 Parmly Store 帳戶可在你加入的每個 Desk 產品中使用。", cta_h: "經營服務業務？總有一個 Desk 適合你。", cta_button: "了解 NailDesk", footer_copy: "© 2026 Parmly Store。惟尼與香港。" }, "zh-hans": { nav_products: "产品", nav_pricing: "价格", nav_support: "支持", nav_get_started: "开始使用", badge: "你负责运营，我们负责管理", h1: "为单一行业打造的软件", subtext: "Parmly Store 为服务业提供预约、客户和财务管理工具——每个行业一个专属应用，没有多余功能。", hero_get_started: "开始使用", hero_see_products: "查看所有产品", products_header: "我们的产品", products_note: "NailDesk 和 StudioDesk 已上线，还有三个即将推出。", nail_status: "已上线・最受欢迎", nail_tagline: "美甲店专用", nail_desc: "为一张或十张美甲椅打造的预约、客户和财务管理。", nail_cta: "了解 NailDesk", train_status: "即将推出", train_tagline: "私人教练专用", train_desc: "课程、套票和付款，全部在一个日历内完成。", train_cta: "通知我", studio_status: 已上线", studio_tagline: "瑜伽、普拉提与Lagree专用", studio_desc: "课程安排、会籍和工作室财务管理。", studio_cta: "了解 StudioDesk", tutor_status: "即将推出", tutor_tagline: "辅导老师专用", tutor_desc: "简化课程预约、学生记录和发票。", tutor_cta: "通知我", salon_status: "即将推出", salon_tagline: "美发美容院专用", salon_desc: "统一椅位预约、客户记录和薪资。", salon_cta: "通知我", feat1_h: "为小型团队打造", feat1_p: "每个产品都专为单一地点的服务业设计，没有繁琐的企业设置。", feat2_h: "澳洲和香港皆适用", feat2_p: "全面支持英文、繁体中文和简体中文，符合当地付款和税务规范。", feat3_h: "一个账户，通用所有应用", feat3_p: "你的 Parmly Store 账户可在你加入的每个 Desk 产品中使用。", cta_h: "经营服务业务？总有一个 Desk 适合你。", cta_button: "了解 NailDesk", footer_copy: "© 2026 Parmly Store。悉尼与香港。" } }; function applyLocale(lang) { var dict = translations[lang] || translations.en; document.querySelectorAll('[data-i18n]').forEach(function (el) { var key = el.getAttribute('data-i18n'); if (dict[key]) el.innerHTML = dict[key]; }); var labels = { en: 'EN', 'zh-hant': '繁', 'zh-hans': '简' }; document.getElementById('localeBtn').textContent = labels[lang] || 'EN'; document.documentElement.lang = lang === 'en' ? 'en' : (lang === 'zh-hant' ? 'zh-Hant' : 'zh-Hans'); try { localStorage.setItem('parmly_locale', lang); } catch (e) {} } var sw = document.getElementById('localeSwitch'); var btn = document.getElementById('localeBtn'); btn.addEventListener('click', function () { sw.classList.toggle('open'); btn.setAttribute('aria-expanded', sw.classList.contains('open')); }); document.addEventListener('click', function (e) { if (!sw.contains(e.target)) sw.classList.remove('open'); }); document.querySelectorAll('.locale-menu button').forEach(function (b) { b.addEventListener('click', function () { applyLocale(b.getAttribute('data-locale')); sw.classList.remove('open'); }); }); (function initLocale() { var saved = null; try { saved = localStorage.getItem('parmly_locale'); } catch (e) {} var path = window.location.pathname; var initial = saved || (path.indexOf('/hk/') !== -1 ? 'zh-hant' : 'en'); applyLocale(initial); })(); </script> </body> </html> 
